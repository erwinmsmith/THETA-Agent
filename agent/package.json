{
  "name": "@theta-agent/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent core, orchestration, runtime composition, and application services.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "node ../scripts/clean-package.mjs agent/dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codesoul-co/hypha-adapters-local": "1.0.1",
    "@codesoul-co/hypha-core": "1.0.1",
    "@codesoul-co/hypha-domain": "1.0.1",
    "@codesoul-co/hypha-harness": "1.0.1",
    "@codesoul-co/hypha-inference": "1.0.1",
    "@codesoul-co/hypha-skills": "1.0.1",
    "@codesoul-co/hypha-tools": "1.0.1",
    "@theta-agent/domain": "workspace:*",
    "@theta-agent/tools": "workspace:*",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.3.0"
  }
}

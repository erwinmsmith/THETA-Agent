{
  "name": "theta-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first conversational auto-research system with THETA as its first research domain.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "deps:ensure": "node scripts/upstreams.mjs ensure",
    "deps:sync": "node scripts/upstreams.mjs sync",
    "deps:update": "node scripts/upstreams.mjs update",
    "env:import:hypha": "node scripts/import-hypha-env.mjs",
    "python:sync": "uv sync",
    "python:sync:training": "uv sync --extra training",
    "install:workspace": "pnpm install --frozen-lockfile",
    "cli:install": "pnpm install --frozen-lockfile",
    "build:domain": "pnpm --filter @theta-agent/domain run build",
    "build:tools": "pnpm --filter @theta-agent/tools run build",
    "build:agent": "pnpm --filter @theta-agent/agent run build",
    "build:apps": "pnpm --filter @theta-agent/cli run build && pnpm --filter @theta-agent/api run build && pnpm --filter @theta-agent/web run build",
    "build": "npm run build:domain && npm run build:tools && npm run build:agent && npm run build:apps",
    "test:python": "pnpm --filter @theta-agent/tools run test:python",
    "test:registries": "node scripts/check-registries.mjs",
    "test:providers": "node scripts/check-providers.mjs",
    "test:interactions": "node scripts/check-fsm-interactions.mjs",
    "test:docs": "node scripts/check-cli-docs.mjs",
    "cli": "node --disable-warning=ExperimentalWarning apps/cli/dist/cli.js",
    "model": "npm run cli -- model",
    "rag:build": "npm run cli -- rag build --json",
    "predoctor": "npm run deps:ensure",
    "doctor": "npm run cli -- doctor",
    "prestart": "npm run deps:ensure",
    "start": "npm run cli -- repl",
    "start:api": "pnpm --filter @theta-agent/api run start",
    "validate": "node scripts/validate-repository.mjs && npm run test:docs",
    "build:web": "pnpm --filter @theta-agent/web run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@codesoul-co/hypha-adapters-local": "1.0.1",
    "@codesoul-co/hypha-core": "1.0.1",
    "@codesoul-co/hypha-domain": "1.0.1",
    "@codesoul-co/hypha-fsm": "1.0.1",
    "@codesoul-co/hypha-harness": "1.0.1",
    "@codesoul-co/hypha-inference": "1.0.1",
    "@codesoul-co/hypha-kernel": "1.0.1",
    "@codesoul-co/hypha-mcp": "1.0.1",
    "@codesoul-co/hypha-memory": "1.0.1",
    "@codesoul-co/hypha-skills": "1.0.1",
    "@codesoul-co/hypha-storage": "1.0.1",
    "@codesoul-co/hypha-tools": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "pg": "8.22.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

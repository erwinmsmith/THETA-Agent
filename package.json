{
  "name": "theta-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first conversational auto-research system with THETA as its first research domain.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "deps:ensure": "node scripts/upstreams.mjs ensure",
    "deps:status": "node scripts/upstreams.mjs status",
    "deps:sync": "node scripts/upstreams.mjs sync",
    "deps:update": "node scripts/upstreams.mjs update",
    "python:sync": "uv sync",
    "python:sync:training": "uv sync --extra training",
    "hypha:install": "npm --prefix third_party/Hypha ci --ignore-scripts",
    "hypha:build": "npm --prefix third_party/Hypha run build:packages",
    "install:workspace": "pnpm install --frozen-lockfile",
    "cli:install": "pnpm install --frozen-lockfile",
    "build:domain": "pnpm --filter @theta-agent/domain run build",
    "build:tools": "pnpm --filter @theta-agent/tools run build",
    "build:agent": "pnpm --filter @theta-agent/agent run build",
    "build:apps": "pnpm --filter @theta-agent/cli run build && pnpm --filter @theta-agent/api run build",
    "build": "npm run build:domain && npm run build:tools && npm run build:agent && npm run build:apps",
    "test:python": "pnpm --filter @theta-agent/tools run test:python",
    "test:registries": "node scripts/check-registries.mjs",
    "rag:build": "pnpm --filter @theta-agent/cli run cli -- rag build --json",
    "predoctor": "npm run deps:ensure",
    "doctor": "pnpm --filter @theta-agent/cli run cli -- doctor",
    "prestart": "npm run deps:ensure",
    "start": "pnpm --filter @theta-agent/cli run cli -- repl",
    "start:api": "pnpm --filter @theta-agent/api run start",
    "validate": "node scripts/validate-repository.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hypha/adapters-local": "file:third_party/Hypha/packages/adapters-local",
    "@hypha/core": "file:third_party/Hypha/packages/core",
    "@hypha/domain": "file:third_party/Hypha/packages/domain",
    "@hypha/fsm": "file:third_party/Hypha/packages/fsm",
    "@hypha/harness": "file:third_party/Hypha/packages/harness",
    "@hypha/inference": "file:third_party/Hypha/packages/inference",
    "@hypha/kernel": "file:third_party/Hypha/packages/kernel",
    "@hypha/mcp": "file:third_party/Hypha/packages/mcp",
    "@hypha/memory": "file:third_party/Hypha/packages/memory",
    "@hypha/skills": "file:third_party/Hypha/packages/skills",
    "@hypha/storage": "file:third_party/Hypha/packages/storage",
    "@hypha/tools": "file:third_party/Hypha/packages/tools",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "pg": "8.22.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  }
}

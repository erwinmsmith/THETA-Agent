{
  "name": "@theta-agent/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governed Agent tools and THETA execution adapters.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "node ../scripts/clean-package.mjs tools/dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:python": "uv run --project .. python -m unittest discover THETA_tools/tests -p \"test_*.py\""
  },
  "dependencies": {
    "@codesoul-co/hypha-adapters-local": "1.0.1",
    "@codesoul-co/hypha-core": "1.0.1",
    "@codesoul-co/hypha-harness": "1.0.1",
    "@codesoul-co/hypha-inference": "1.0.1",
    "@codesoul-co/hypha-tools": "1.0.1",
    "@theta-agent/domain": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.3.0"
  }
}

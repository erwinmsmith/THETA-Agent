# Optional bounded MiniMax language provider.
# Copy this file to .env at the repository root and keep the real key private.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_MS=60000
MINIMAX_PLANNER_TIMEOUT_MS=120000
THETA_RESULT_ANALYSIS_TIMEOUT_MS=120000

# Optional local path overrides. Defaults point into ignored third_party/.
# THETA_UPSTREAM_ROOT=/absolute/path/to/THETA
# HYPHA_UPSTREAM_ROOT=/absolute/path/to/Hypha
# THETA_AGENT_BRIDGE_PYTHON=/absolute/path/to/python

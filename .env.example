# Optional language-model selection. Saved CLI selections take precedence.
# Local execution is the only backend today. CPU is the safe default for any
# plan that does not explicitly request a device; scheduler dispatch is a
# future backend and is not enabled by this configuration.
THETA_COMPUTE_BACKEND=local
THETA_COMPUTE_DEVICE=cpu

THETA_LLM_PROVIDER=deepseek
THETA_LLM_MODEL=deepseek-v4-flash
THETA_LLM_TIMEOUT_MS=60000
THETA_LLM_PLANNER_TIMEOUT_MS=120000
# Optional: pin the planner to a chat-style model when the default provider
# is reasoning-capable and leaves the response content empty.
# THETA_LLM_PLANNER_MODEL=deepseek-chat
THETA_LLM_UNDERSTANDING_TIMEOUT_MS=120000

# DeepSeek (default)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# MiniMax
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2.7

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=THETA Agent

# Local Ollama (API key is normally unnecessary)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=
# OLLAMA_API_KEY=

# Any other OpenAI-compatible endpoint
# THETA_COMPAT_BASE_URL=
# THETA_COMPAT_API_KEY=
# THETA_COMPAT_MODEL=
